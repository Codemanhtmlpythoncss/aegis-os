# Aegis core — always installed, every profile/DE.
# Base system, firewall, sandboxing, hardening, and live tooling.

# --- live system + boot ---
# (the kernel is added automatically by live-build for the target architecture)
live-boot
live-config
live-config-systemd
# user-setup is only *Recommended* by live-config, and we build with
# --apt-recommends false. Without it, live-config's 0030-user-setup skips
# entirely: no live 'user' account is created and no password is set, so
# lightdm autologin fails (you land on the greeter) and 'user'/'live' is
# rejected. Pull it in explicitly.
user-setup
firmware-linux-free

# --- firewall / networking ---
nftables
network-manager
network-manager-gnome
macchanger
rfkill
wireless-tools
iw
# split-tunnel DNS (domain bypass) + VPN support + Tor pluggable transport
dnsmasq
wireguard-tools
openvpn
obfs4proxy

# --- sandboxing & mandatory access control ---
firejail
firejail-profiles
bubblewrap
apparmor
apparmor-profiles
apparmor-profiles-extra
apparmor-utils

# --- device / boot security ---
usbguard
secure-delete

# --- crypto / disk ---
cryptsetup
cryptsetup-initramfs
keepassxc
gnupg
gnupg-agent
scdaemon

# --- privacy utilities ---
mat2
python3-gi

# --- base userland ---
sudo
curl
wget
ca-certificates
less
vim-tiny
htop
pciutils
usbutils
console-setup
fastfetch
zenity

# --- Aegis control apps need these ---
python3
python3-gi
gir1.2-gtk-3.0
gir1.2-notify-0.7
polkitd
pkexec

# --- audio (pipewire; one stack for every DE, provides the pulse API) ---
pipewire
pipewire-pulse
wireplumber
