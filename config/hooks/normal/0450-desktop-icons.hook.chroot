#!/bin/sh
# Put every security app launcher directly on the desktop as loose icons (no
# subfolder). Runs after packages install, so the .desktop files (Control Center,
# Tor Connection, Vault, Hardware Guide, I2P IRC, Disks, gufw, KeePassXC, …) are
# present. Launchers must be executable for the file manager to run them as apps.
set -e

DESK=/etc/skel/Desktop
mkdir -p "$DESK"

# Every Aegis launcher plus the extra security tools we ship. Glob patterns that
# match nothing stay literal and are skipped by the -f test.
for f in /usr/share/applications/aegis-*.desktop \
         /usr/share/applications/org.gnome.DiskUtility.desktop \
         /usr/share/applications/*ufw*.desktop \
         /usr/share/applications/hexchat.desktop \
         /usr/share/applications/*keepassxc*.desktop \
         /usr/share/applications/*KeePassXC*.desktop \
         /usr/share/applications/install-aegis.desktop; do
    [ -f "$f" ] && cp -f "$f" "$DESK/" || true
done

# Pure background/helper entries don't belong on the desktop.
rm -f "$DESK/aegis-wallpaper.desktop" "$DESK/aegis-screensaver.desktop" 2>/dev/null || true

chmod +x "$DESK"/*.desktop 2>/dev/null || true
echo "I: seeded $DESK with $(ls "$DESK"/*.desktop 2>/dev/null | wc -l) launcher(s)"
