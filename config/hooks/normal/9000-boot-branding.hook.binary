#!/bin/sh
# Aegis BINARY-stage hook: rebrand the ISO boot menu from "Debian" to "Aegis OS".
# Runs after live-build has generated the GRUB/isolinux bootloader configs.
set -e
echo "I: [aegis] rebranding bootloader menu (Debian -> Aegis OS)"

for base in binary/boot/grub binary/boot/syslinux binary/isolinux binary/syslinux; do
    [ -d "$base" ] || continue
    find "$base" -type f \( -name '*.cfg' -o -name '*.conf' \) 2>/dev/null | while read -r f; do
        sed -i \
            -e 's@Debian GNU/Linux@Aegis OS@g' \
            -e 's@Debian Live@Aegis OS@g' \
            -e 's@Debian@Aegis@g' \
            "$f" 2>/dev/null || true
    done
done

# Guarantee the menu auto-boots even when its graphics don't render in some VMs
# (e.g. UTM showing a black screen) — a fixed timeout picks the default entry.
[ -f binary/boot/grub/grub.cfg ] && sed -i 's/^set timeout=.*/set timeout=5/' binary/boot/grub/grub.cfg 2>/dev/null || true
for ic in binary/isolinux/isolinux.cfg binary/isolinux/menu.cfg binary/syslinux/syslinux.cfg; do
    [ -f "$ic" ] && sed -i -e 's/^timeout .*/timeout 50/' -e 's/^prompt .*/prompt 0/' "$ic" 2>/dev/null || true
done
echo "I: [aegis] bootloader rebrand + auto-boot timeout done"
