# Randomize the hostname before the network comes up.
[Unit]
Description=Aegis random hostname
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target NetworkManager.service systemd-hostnamed.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aegis-hostname

[Install]
WantedBy=multi-user.target
