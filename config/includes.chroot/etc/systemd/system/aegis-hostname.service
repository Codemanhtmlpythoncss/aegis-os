# Randomize the hostname before the network comes up.
[Unit]
Description=Aegis random hostname
# Run AFTER live-config (which sets the hostname to "debian"), so our random name
# is the one that sticks, but before the display manager starts the session.
After=live-config.service
Before=lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aegis-hostname

[Install]
WantedBy=multi-user.target
