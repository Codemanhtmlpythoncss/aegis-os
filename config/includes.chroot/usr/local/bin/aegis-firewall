#!/bin/bash
# aegis-firewall — apply the network mode's firewall. Run as root.
# Usage: aegis-firewall {tor|i2p|both|direct|status}
set -euo pipefail

TOR_RULES=/etc/nftables-tor.conf

die() { echo "aegis-firewall: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "must run as root"

tor_uid() { id -u debian-tor 2>/dev/null || echo 109; }

apply_tor() {
    local uid; uid=$(tor_uid)
    # Rewrite the TOR_UID define to the real uid, then load.
    sed "s/^define TOR_UID.*/define TOR_UID = ${uid}/" "$TOR_RULES" | nft -f -
    # Ensure tor is up WITHOUT a restart: at boot a 'restart' here creates a
    # conflicting job transaction that cancels other services. 'start --no-block'
    # is a no-op if already (being) started, and never blocks this oneshot.
    systemctl --no-block start tor@default.service 2>/dev/null || systemctl --no-block start tor 2>/dev/null || true
    echo "Firewall: TOR transparent mode (fail-closed). All traffic via Tor."
}

apply_direct() {
    # Minimal stateful firewall, no forced routing (used by offensive profile).
    nft -f - <<'EOF'
flush ruleset
table inet aegis {
  chain input   { type filter hook input priority 0; policy drop;
                  ct state established,related accept; iif "lo" accept; }
  chain forward { type filter hook forward priority 0; policy drop; }
  chain output  { type filter hook output priority 0; policy accept; }
}
EOF
    echo "Firewall: DIRECT mode. No forced anonymity routing (NOT anonymous)."
}

apply_i2p() {
    # I2P is a userspace overlay (i2pd). We don't transparently proxy everything
    # through it; instead we run a tight firewall and expose i2pd's SOCKS/HTTP
    # proxies (127.0.0.1:4447 / 4444). Apps opt in via proxy settings.
    nft -f - <<'EOF'
flush ruleset
table inet aegis {
  chain input   { type filter hook input priority 0; policy drop;
                  ct state established,related accept; iif "lo" accept; }
  chain forward { type filter hook forward priority 0; policy drop; }
  chain output  { type filter hook output priority 0; policy accept; }
}
EOF
    systemctl --no-block start i2pd 2>/dev/null || true
    echo "Firewall: I2P mode. i2pd proxies on 127.0.0.1:4444 (HTTP) / 4447 (SOCKS)."
}

case "${1:-status}" in
    tor)    apply_tor ;;
    direct) apply_direct ;;
    i2p)    apply_i2p ;;
    both)   apply_tor; systemctl --no-block start i2pd 2>/dev/null || true
            echo "Plus i2pd proxies on 127.0.0.1:4444/4447 (I2P-only destinations)." ;;
    status) nft list ruleset ;;
    *) die "usage: aegis-firewall {tor|i2p|both|direct|status}" ;;
esac
