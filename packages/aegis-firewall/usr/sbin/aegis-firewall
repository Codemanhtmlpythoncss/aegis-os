#!/bin/bash
# aegis-firewall — apply the network mode's firewall. Run as root.
# Usage: aegis-firewall {tor|i2p|both|direct|status}
#
# Routing model: everything is forced through Tor (tor/both) or I2P (i2p),
# fail-closed. The only escapes are the split-tunnel sets (bypass4/bypass6,
# managed by aegis-route) and apps launched in the aegis-clearnet group
# (aegis-run-clearnet). There is no blanket LAN bypass.
set -euo pipefail

TOR_RULES=/etc/aegis/nftables-tor.conf
I2P_RULES=/etc/aegis/nftables-i2p.conf
PROXY_ENV=/etc/profile.d/10-aegis-i2p-proxy.sh

die() { echo "aegis-firewall: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "must run as root"

tor_uid()     { id -u debian-tor 2>/dev/null || echo 109; }
i2pd_uid()    { id -u i2pd 2>/dev/null || echo 108; }
clearnet_gid(){ getent group aegis-clearnet 2>/dev/null | cut -d: -f3 || echo 700; }

# Substitute the real uids/gids into a ruleset file, then load it.
load_rules() {
    local f="$1"
    sed -e "s/^define TOR_UID.*/define TOR_UID = $(tor_uid)/" \
        -e "s/^define I2PD_UID.*/define I2PD_UID = $(i2pd_uid)/" \
        -e "s/^define CLEARNET_GID.*/define CLEARNET_GID = $(clearnet_gid)/" \
        "$f" | nft -f -
}

# System HTTP(S) proxy -> i2pd (for proxy-aware apps in I2P mode); cleared otherwise.
set_i2p_proxy() {
    cat > "$PROXY_ENV" <<'EOF'
# Aegis: route proxy-aware apps through the I2P HTTP proxy (set in I2P mode).
export http_proxy="http://127.0.0.1:4444"
export https_proxy="http://127.0.0.1:4444"
export HTTP_PROXY="$http_proxy"
export HTTPS_PROXY="$https_proxy"
export no_proxy="127.0.0.1,localhost"
EOF
}
clear_i2p_proxy() { rm -f "$PROXY_ENV"; }

# Re-apply saved split-tunnel IP/CIDR bypasses into the freshly loaded ruleset.
# `flush ruleset` recreates the bypass sets empty, so without this every custom
# IP route would vanish on each mode switch / reboot.
reload_bypass() {
    [ -x /usr/sbin/aegis-route ] && /usr/sbin/aegis-route reload >/dev/null 2>&1 || true
}

# dnsmasq as the local resolver, forwarding to Tor's DNSPort. This is what makes
# name resolution work under the fail-closed firewall: without it resolv.conf is
# empty (or a stub the firewall blocks) and every lookup fails ("couldn't resolve
# host"). It also backs domain split-tunnel (aegis-route-domain drops files in
# aegis-bypass.d).
ensure_tor_dns() {
    if command -v dnsmasq >/dev/null 2>&1; then
        mkdir -p /etc/dnsmasq.d/aegis-bypass.d
        cat > /etc/dnsmasq.d/aegis.conf <<'EOF'
# Aegis: resolve everything over Tor (Tor's DNSPort on 127.0.0.1:5353), with
# split-DNS for bypassed domains (files in aegis-bypass.d, by aegis-route-domain).
no-resolv
listen-address=127.0.0.1
bind-interfaces
cache-size=1000
server=127.0.0.1#5353
conf-dir=/etc/dnsmasq.d/aegis-bypass.d
EOF
        # A distro stub resolver would fight us (and can't egress when fail-closed).
        systemctl disable --now systemd-resolved 2>/dev/null || true
        systemctl --no-block restart dnsmasq 2>/dev/null || systemctl --no-block start dnsmasq 2>/dev/null || true
    fi
    # Point the system at the local resolver (break any resolvconf symlink first).
    [ -L /etc/resolv.conf ] && rm -f /etc/resolv.conf
    printf 'nameserver 127.0.0.1\noptions edns0\n' > /etc/resolv.conf 2>/dev/null || true
}

apply_tor() {
    load_rules "$TOR_RULES"
    systemctl --no-block start tor@default.service 2>/dev/null || systemctl --no-block start tor 2>/dev/null || true
    ensure_tor_dns
    reload_bypass
    clear_i2p_proxy
    echo "Firewall: TOR transparent mode (fail-closed). All traffic via Tor."
}

apply_i2p() {
    load_rules "$I2P_RULES"
    systemctl --no-block start i2pd 2>/dev/null || true
    set_i2p_proxy
    echo "Firewall: I2P mode (fail-closed). Only i2pd egresses; apps use 127.0.0.1:4444 (HTTP) / 4447 (SOCKS)."
    echo "          .i2p works natively; clearnet is carried by i2pd's HTTP outproxy."
}

apply_both() {
    load_rules "$TOR_RULES"
    # Also let i2pd reach the network directly, alongside Tor transparent routing.
    nft insert rule inet aegis output_nat    meta skuid "$(i2pd_uid)" accept 2>/dev/null || true
    nft insert rule inet aegis output_filter meta skuid "$(i2pd_uid)" accept 2>/dev/null || true
    systemctl --no-block start tor@default.service 2>/dev/null || systemctl --no-block start tor 2>/dev/null || true
    systemctl --no-block start i2pd 2>/dev/null || true
    ensure_tor_dns
    reload_bypass
    clear_i2p_proxy
    echo "Firewall: BOTH. Tor transparent for everything; i2pd proxies on 127.0.0.1:4444/4447 for .i2p."
}

apply_vpn() {
    local gid; gid=$(clearnet_gid)
    # Kill-switch: only the VPN tunnel interface (+ handshake to bring it up, and
    # the split-tunnel escapes) may egress. If the tunnel drops, traffic is cut.
    nft -f - <<EOF
flush ruleset
table inet aegis {
  set bypass4 { type ipv4_addr; flags interval; }
  set bypass6 { type ipv6_addr; flags interval; }
  chain input  { type filter hook input priority 0; policy drop;
                 ct state established,related accept; iif "lo" accept;
                 iifname {"wg0","wg1","tun0","tun1"} accept; }
  chain output { type filter hook output priority 0; policy drop;
                 ct state established,related accept; oif "lo" accept;
                 oifname {"wg0","wg1","tun0","tun1"} accept;
                 meta skgid $gid accept;
                 ip daddr @bypass4 accept; ip6 daddr @bypass6 accept;
                 udp dport 51820 accept;
                 udp dport {1194,1195} accept; tcp dport {1194,443} accept; }
  chain forward { type filter hook forward priority 0; policy drop; }
}
EOF
    reload_bypass
    clear_i2p_proxy
    echo "Firewall: VPN kill-switch. Only the VPN tunnel (+ handshake) may reach the network."
}

apply_direct() {
    nft -f - <<'EOF'
flush ruleset
table inet aegis {
  chain input   { type filter hook input priority 0; policy drop;
                  ct state established,related accept; iif "lo" accept; }
  chain forward { type filter hook forward priority 0; policy drop; }
  chain output  { type filter hook output priority 0; policy accept; }
}
EOF
    clear_i2p_proxy
    echo "Firewall: DIRECT mode. No forced anonymity routing (NOT anonymous)."
}

case "${1:-status}" in
    tor)    apply_tor ;;
    i2p)    apply_i2p ;;
    both)   apply_both ;;
    vpn)    apply_vpn ;;
    direct) apply_direct ;;
    status) nft list ruleset ;;
    *) die "usage: aegis-firewall {tor|i2p|both|direct|status}" ;;
esac
