#!/usr/bin/python3
# Aegis Control Center — the one place to manage Aegis: connection (Tor / I2P /
# VPN / Direct), live status, and split-tunnelling (which apps, sites and IPs
# skip the tunnel). Runs unprivileged; privileged actions go through pkexec to
# small audited helpers (aegis-netmode-set, aegis-route, aegis-route-domain,
# aegis-run-clearnet, aegis-vpn).
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Pango
import os
import socket
import subprocess

TEAL = "#2dd4bf"
RED = "#ef4444"
DIM = "#8b9bb4"

NETMODE_FILE = "/etc/aegis/netmode"
VPN_DIR = "/etc/aegis/vpn"
MODES = [
    ("tor",    "Tor",    "Everything through Tor, fail-closed. Recommended."),
    ("both",   "Both",   "Tor for everything, plus i2pd proxies for .i2p sites."),
    ("i2p",    "I2P",    "Fail-closed: all egress via I2P. Clearnet via outproxy."),
    ("vpn",    "VPN",    "Everything through your selected VPN (kill-switch on)."),
    ("direct", "Direct", "No anonymity routing. NOT anonymous — setup only."),
]


# ------------------------------------------------------------------ helpers
def helper(name):
    for base in ("/usr/sbin", "/usr/bin", "/usr/local/sbin", "/usr/local/bin"):
        p = os.path.join(base, name)
        if os.path.exists(p):
            return p
    return "/usr/sbin/" + name


def run(cmd, timeout=15):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except Exception as e:  # noqa: BLE001
        class R:
            returncode = 1
            stdout = ""
            stderr = str(e)
        return R()


def pkexec(args, timeout=90):
    return run(["pkexec"] + args, timeout=timeout)


def read_netmode():
    try:
        with open(NETMODE_FILE) as f:
            return f.read().strip() or "tor"
    except OSError:
        return "tor"


def is_active(unit):
    return run(["systemctl", "is-active", unit]).stdout.strip() == "active"


def tor_bootstrap():
    """Return (percent:int, summary:str) from Tor's control port, or (-1, msg)."""
    cookie = None
    for p in ("/run/tor/control.authcookie", "/var/run/tor/control.authcookie"):
        try:
            with open(p, "rb") as f:
                cookie = f.read().hex()
            break
        except OSError:
            continue
    try:
        s = socket.create_connection(("127.0.0.1", 9051), timeout=4)
        s.settimeout(4)
        if cookie:
            s.sendall(f"AUTHENTICATE {cookie}\r\n".encode())
        else:
            s.sendall(b'AUTHENTICATE ""\r\n')
        s.recv(256)
        s.sendall(b"GETINFO status/bootstrap-phase\r\n")
        data = s.recv(1024).decode(errors="replace")
        s.close()
        pct = -1
        for tok in data.split():
            if tok.startswith("PROGRESS="):
                pct = int(tok.split("=", 1)[1])
        summ = ""
        if "SUMMARY=" in data:
            summ = data.split("SUMMARY=", 1)[1].strip().strip('"').split('"')[0]
        return pct, (summ or "")
    except Exception:  # noqa: BLE001
        return -1, "control port unavailable"


def colored(text, color):
    return f'<span foreground="{color}">{GLib.markup_escape_text(text)}</span>'


# ------------------------------------------------------------------ main window
class AegisControl(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aegis Control Center")
        self.set_default_size(760, 560)

        hb = Gtk.HeaderBar(show_close_button=True, title="Aegis Control Center",
                           subtitle="privacy · anonymity")
        self.set_titlebar(hb)
        refresh = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
        refresh.set_tooltip_text("Refresh")
        refresh.connect("clicked", lambda *_: self.refresh_all())
        hb.pack_end(refresh)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        sidebar = Gtk.StackSidebar()
        sidebar.set_stack(self.stack)
        sidebar.set_size_request(150, -1)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        box.pack_start(sidebar, False, False, 0)
        box.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)
        box.pack_start(self.stack, True, True, 0)
        self.add(box)

        self.stack.add_titled(self._page_status(), "status", "Status")
        self.stack.add_titled(self._page_tor(), "tor", "Tor")
        self.stack.add_titled(self._page_i2p(), "i2p", "I2P")
        self.stack.add_titled(self._page_vpn(), "vpn", "VPN")
        self.stack.add_titled(self._page_split(), "split", "Split-tunnel")

        self.refresh_all()
        GLib.timeout_add_seconds(5, self._tick)

    # ---------- small ui helpers ----------
    def _scroller(self, child):
        sc = Gtk.ScrolledWindow()
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.add(child)
        return sc

    def _vbox(self, pad=16, spacing=12):
        b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)
        b.set_border_width(pad)
        return b

    def _heading(self, text):
        l = Gtk.Label(xalign=0)
        l.set_markup(f"<span size='large' weight='bold'>{GLib.markup_escape_text(text)}</span>")
        return l

    def toast(self, text, err=False):
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=(Gtk.MessageType.ERROR if err else Gtk.MessageType.INFO),
                              buttons=Gtk.ButtonsType.OK, text=text)
        d.run(); d.destroy()

    def ask(self, title, placeholder=""):
        d = Gtk.Dialog(title=title, transient_for=self, modal=True)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
        e = Gtk.Entry(); e.set_placeholder_text(placeholder); e.set_activates_default(True)
        e.set_margin_top(10); e.set_margin_bottom(10); e.set_margin_start(12); e.set_margin_end(12)
        e.set_width_chars(36)
        d.get_content_area().add(e)
        d.set_default_response(Gtk.ResponseType.OK)
        d.show_all()
        resp = d.run(); val = e.get_text().strip(); d.destroy()
        return val if resp == Gtk.ResponseType.OK else None

    # ---------- Status ----------
    def _page_status(self):
        b = self._vbox()
        b.pack_start(self._heading("Status"), False, False, 0)
        grid = Gtk.Grid(column_spacing=14, row_spacing=8)
        b.pack_start(grid, False, False, 0)
        self.s_mode = self._kv(grid, 0, "Network mode")
        self.s_tor = self._kv(grid, 1, "Tor")
        self.s_i2p = self._kv(grid, 2, "I2P (i2pd)")
        self.s_vpn = self._kv(grid, 3, "VPN")
        self.s_fw = self._kv(grid, 4, "Firewall")

        b.pack_start(Gtk.Separator(), False, False, 6)
        b.pack_start(self._heading("Switch mode"), False, False, 0)
        self.mode_radios = {}
        group = None
        for key, name, desc in MODES:
            rb = Gtk.RadioButton.new_with_label_from_widget(group, name)
            group = group or rb
            d = Gtk.Label(xalign=0); d.set_margin_start(26)
            d.set_markup(f"<small>{colored(desc, DIM)}</small>")
            b.pack_start(rb, False, False, 0)
            b.pack_start(d, False, False, 0)
            self.mode_radios[key] = rb
        apply_btn = Gtk.Button(label="Apply mode")
        apply_btn.get_style_context().add_class("suggested-action")
        apply_btn.connect("clicked", self.on_apply_mode)
        b.pack_start(apply_btn, False, False, 6)
        return self._scroller(b)

    def _kv(self, grid, row, name):
        k = Gtk.Label(label=name, xalign=0); k.set_width_chars(14)
        v = Gtk.Label(xalign=0); v.set_ellipsize(Pango.EllipsizeMode.END)
        grid.attach(k, 0, row, 1, 1); grid.attach(v, 1, row, 1, 1)
        return v

    def on_apply_mode(self, _b):
        mode = next((k for k, rb in self.mode_radios.items() if rb.get_active()), "tor")
        if mode == "vpn":
            name = self._selected_vpn()
            if not name:
                self.toast("Add and select a VPN on the VPN page first.", err=True); return
            r = pkexec([helper("aegis-vpn"), "mode", name])
        else:
            r = pkexec([helper("aegis-netmode-set"), mode])
        self.toast(f"Mode set to {mode.upper()}." if r.returncode == 0
                   else f"Failed: {r.stderr.strip() or 'cancelled'}", err=(r.returncode != 0))
        self.refresh_all()

    # ---------- Tor ----------
    def _page_tor(self):
        b = self._vbox()
        b.pack_start(self._heading("Tor connection"), False, False, 0)
        self.tor_state = Gtk.Label(xalign=0)
        b.pack_start(self.tor_state, False, False, 0)
        self.tor_bar = Gtk.ProgressBar(show_text=True)
        b.pack_start(self.tor_bar, False, False, 0)

        row = Gtk.Box(spacing=8)
        connect = Gtk.Button(label="Connect to Tor")
        connect.get_style_context().add_class("suggested-action")
        connect.connect("clicked", lambda *_: self._tor_action("start"))
        reconnect = Gtk.Button(label="New circuit")
        reconnect.connect("clicked", lambda *_: self._tor_newnym())
        row.pack_start(connect, False, False, 0)
        row.pack_start(reconnect, False, False, 0)
        b.pack_start(row, False, False, 0)

        b.pack_start(Gtk.Separator(), False, False, 6)
        b.pack_start(self._heading("Bridges"), False, False, 0)
        info = Gtk.Label(xalign=0); info.set_line_wrap(True)
        info.set_markup(f"<small>{colored('If Tor is blocked on your network, add obfs4 bridges (get them from https://bridges.torproject.org). One per line.', DIM)}</small>")
        b.pack_start(info, False, False, 0)
        self.bridges_text = Gtk.TextView()
        self.bridges_text.set_monospace(True)
        self.bridges_text.get_buffer().set_text(self._read_bridges())
        sc = Gtk.ScrolledWindow(); sc.set_size_request(-1, 90)
        sc.set_shadow_type(Gtk.ShadowType.IN); sc.add(self.bridges_text)
        b.pack_start(sc, False, False, 0)
        self.bridges_toggle = Gtk.CheckButton(label="Use bridges")
        self.bridges_toggle.set_active(self._bridges_enabled())
        b.pack_start(self.bridges_toggle, False, False, 0)
        save = Gtk.Button(label="Save bridges & reconnect")
        save.connect("clicked", self.on_save_bridges)
        b.pack_start(save, False, False, 0)
        return self._scroller(b)

    def _tor_action(self, what):
        pkexec(["systemctl", what, "tor@default.service"])
        self.refresh_tor()

    def _tor_newnym(self):
        r = pkexec(["sh", "-c", "pkill -HUP tor || systemctl reload tor@default.service"])
        self.toast("Requested a new Tor circuit." if r.returncode == 0 else "Could not signal Tor.",
                   err=(r.returncode != 0))

    def _read_bridges(self):
        try:
            with open("/etc/tor/torrc.d/10-aegis-bridges.conf") as f:
                return "\n".join(l.split("Bridge ", 1)[1].strip()
                                 for l in f if l.strip().startswith("Bridge "))
        except OSError:
            return ""

    def _bridges_enabled(self):
        try:
            with open("/etc/tor/torrc.d/10-aegis-bridges.conf") as f:
                return "UseBridges 1" in f.read()
        except OSError:
            return False

    def on_save_bridges(self, _b):
        buf = self.bridges_text.get_buffer()
        text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), True)
        lines = [l.strip() for l in text.splitlines() if l.strip()]
        use = "1" if (self.bridges_toggle.get_active() and lines) else "0"
        conf = "# managed by Aegis Control Center\n"
        if use == "1":
            conf += "UseBridges 1\nClientTransportPlugin obfs4,meek_lite exec /usr/bin/obfs4proxy\n"
            conf += "".join(f"Bridge {l}\n" for l in lines)
        r = pkexec([helper("aegis-tor-bridges"), "save", conf])
        self.toast("Bridges saved; Tor reconnecting." if r.returncode == 0
                   else f"Failed: {r.stderr.strip() or 'cancelled'}", err=(r.returncode != 0))
        self.refresh_tor()

    # ---------- I2P ----------
    def _page_i2p(self):
        b = self._vbox()
        b.pack_start(self._heading("I2P router"), False, False, 0)
        self.i2p_state = Gtk.Label(xalign=0)
        b.pack_start(self.i2p_state, False, False, 0)
        row = Gtk.Box(spacing=8)
        for label, act in (("Start", "start"), ("Stop", "stop"), ("Restart", "restart")):
            btn = Gtk.Button(label=label)
            btn.connect("clicked", lambda _w, a=act: (pkexec(["systemctl", a, "i2pd"]), self.refresh_i2p()))
            row.pack_start(btn, False, False, 0)
        console = Gtk.Button(label="Open I2P console")
        console.connect("clicked", lambda *_: run(["xdg-open", "http://127.0.0.1:7070"]))
        row.pack_start(console, False, False, 0)
        b.pack_start(row, False, False, 0)
        note = Gtk.Label(xalign=0); note.set_line_wrap(True)
        note.set_markup(f"<small>{colored('I2P reaches .i2p sites natively; clearnet is carried by a volunteer HTTP outproxy (slower). Proxies: HTTP 127.0.0.1:4444, SOCKS 127.0.0.1:4447.', DIM)}</small>")
        b.pack_start(note, False, False, 6)
        return self._scroller(b)

    # ---------- VPN ----------
    def _page_vpn(self):
        b = self._vbox()
        b.pack_start(self._heading("VPN"), False, False, 0)
        info = Gtk.Label(xalign=0); info.set_line_wrap(True)
        info.set_markup(f"<small>{colored('Import a WireGuard (.conf) or OpenVPN (.ovpn) config. Selecting VPN mode routes everything through it with a kill-switch.', DIM)}</small>")
        b.pack_start(info, False, False, 0)

        self.vpn_list = Gtk.ListBox()
        self.vpn_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        sc = Gtk.ScrolledWindow(); sc.set_size_request(-1, 160); sc.set_shadow_type(Gtk.ShadowType.IN)
        sc.add(self.vpn_list)
        b.pack_start(sc, True, True, 0)

        row = Gtk.Box(spacing=8)
        imp = Gtk.Button(label="Import config…")
        imp.connect("clicked", self.on_vpn_import)
        up = Gtk.Button(label="Connect"); up.connect("clicked", lambda *_: self._vpn_do("up"))
        down = Gtk.Button(label="Disconnect"); down.connect("clicked", lambda *_: self._vpn_do("down"))
        rm = Gtk.Button(label="Remove"); rm.connect("clicked", lambda *_: self._vpn_do("remove"))
        for w in (imp, up, down, rm):
            row.pack_start(w, False, False, 0)
        b.pack_start(row, False, False, 0)
        return self._scroller(b)

    def _selected_vpn(self):
        r = self.vpn_list.get_selected_row()
        return r.get_child().get_text() if r else None

    def on_vpn_import(self, _b):
        dlg = Gtk.FileChooserDialog(title="Import VPN config", transient_for=self,
                                    action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Import", Gtk.ResponseType.OK)
        flt = Gtk.FileFilter(); flt.set_name("VPN configs (*.conf, *.ovpn)")
        flt.add_pattern("*.conf"); flt.add_pattern("*.ovpn")
        dlg.add_filter(flt)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            r = pkexec([helper("aegis-vpn"), "import", path])
            self.toast("VPN imported." if r.returncode == 0
                       else f"Import failed: {r.stderr.strip()}", err=(r.returncode != 0))
            self.refresh_vpn()
        dlg.destroy()

    def _vpn_do(self, action):
        name = self._selected_vpn()
        if not name:
            self.toast("Select a VPN first.", err=True); return
        r = pkexec([helper("aegis-vpn"), action, name])
        self.toast(f"VPN {action}: {name}" if r.returncode == 0
                   else f"Failed: {r.stderr.strip() or 'cancelled'}", err=(r.returncode != 0))
        self.refresh_vpn(); self.refresh_status_fields()

    # ---------- Split-tunnel ----------
    def _page_split(self):
        b = self._vbox()
        b.pack_start(self._heading("Split-tunnel"), False, False, 0)
        info = Gtk.Label(xalign=0); info.set_line_wrap(True)
        info.set_markup(f"<small>{colored('Things listed here skip the tunnel and go DIRECT (clearnet). Use sparingly — each exception can deanonymise that traffic.', DIM)}</small>")
        b.pack_start(info, False, False, 0)

        # Apps
        b.pack_start(self._heading("Apps (run outside the tunnel)"), False, False, 4)
        appbtn = Gtk.Button(label="Launch an app clearnet…")
        appbtn.connect("clicked", self.on_launch_clearnet)
        b.pack_start(appbtn, False, False, 0)

        # Sites
        b.pack_start(self._heading("Sites (domains)"), False, False, 4)
        self.site_list = Gtk.ListBox(); self.site_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        ssc = Gtk.ScrolledWindow(); ssc.set_size_request(-1, 90); ssc.set_shadow_type(Gtk.ShadowType.IN)
        ssc.add(self.site_list)
        b.pack_start(ssc, False, False, 0)
        srow = Gtk.Box(spacing=8)
        sa = Gtk.Button(label="Add domain…"); sa.connect("clicked", lambda *_: self._split_add("domain"))
        sd = Gtk.Button(label="Remove"); sd.connect("clicked", lambda *_: self._split_del("domain"))
        srow.pack_start(sa, False, False, 0); srow.pack_start(sd, False, False, 0)
        b.pack_start(srow, False, False, 0)

        # IPs
        b.pack_start(self._heading("IPs / CIDRs"), False, False, 4)
        self.ip_list = Gtk.ListBox(); self.ip_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        isc = Gtk.ScrolledWindow(); isc.set_size_request(-1, 90); isc.set_shadow_type(Gtk.ShadowType.IN)
        isc.add(self.ip_list)
        b.pack_start(isc, False, False, 0)
        irow = Gtk.Box(spacing=8)
        ia = Gtk.Button(label="Add IP…"); ia.connect("clicked", lambda *_: self._split_add("ip"))
        idl = Gtk.Button(label="Remove"); idl.connect("clicked", lambda *_: self._split_del("ip"))
        irow.pack_start(ia, False, False, 0); irow.pack_start(idl, False, False, 0)
        b.pack_start(irow, False, False, 0)
        return self._scroller(b)

    def on_launch_clearnet(self, _b):
        cmd = self.ask("Launch app outside the tunnel", "e.g. firefox  (runs on the clearnet)")
        if not cmd:
            return
        subprocess.Popen([helper("aegis-run-clearnet")] + cmd.split())
        self.toast(f"Launched '{cmd}' outside the tunnel.")

    def _split_add(self, kind):
        if kind == "domain":
            v = self.ask("Bypass a site (domain)", "example.com")
            if v:
                r = pkexec([helper("aegis-route-domain"), "add", v])
                self._after_split(r)
        else:
            v = self.ask("Bypass an IP / CIDR", "1.2.3.4 or 1.2.3.0/24")
            if v:
                r = pkexec([helper("aegis-route"), "add", v])
                self._after_split(r)

    def _split_del(self, kind):
        lst = self.site_list if kind == "domain" else self.ip_list
        row = lst.get_selected_row()
        if not row:
            self.toast("Select one to remove.", err=True); return
        v = row.get_child().get_text()
        tool = "aegis-route-domain" if kind == "domain" else "aegis-route"
        r = pkexec([helper(tool), "del", v])
        self._after_split(r)

    def _after_split(self, r):
        if r.returncode != 0:
            self.toast(f"Failed: {r.stderr.strip() or 'cancelled'}", err=True)
        self.refresh_split()

    # ---------- refresh ----------
    def _fill_list(self, listbox, items):
        for c in listbox.get_children():
            listbox.remove(c)
        for it in items:
            lbl = Gtk.Label(label=it, xalign=0); lbl.set_margin_start(6); lbl.set_margin_end(6)
            listbox.add(lbl)
        if not items:
            lbl = Gtk.Label(xalign=0); lbl.set_markup(f"<small>{colored('(none)', DIM)}</small>")
            lbl.set_margin_start(6); listbox.add(lbl)
        listbox.show_all()

    def refresh_status_fields(self):
        mode = read_netmode()
        self.s_mode.set_markup(colored(mode.upper(), DIM if mode == "direct" else TEAL))
        tor = is_active("tor@default.service") or is_active("tor.service")
        self.s_tor.set_markup(colored("running" if tor else "stopped", TEAL if tor else RED))
        i2p = is_active("i2pd.service")
        self.s_i2p.set_markup(colored("running" if i2p else "stopped", TEAL if i2p else RED))
        vpn = run([helper("aegis-vpn"), "active"]).stdout.strip()
        self.s_vpn.set_markup(colored(vpn or "off", TEAL if vpn else DIM))
        fw = is_active("aegis-netmode.service")
        self.s_fw.set_markup(colored("applied" if fw else "not applied", TEAL if fw else RED))
        btn = self.mode_radios.get(mode)
        if btn:
            btn.set_active(True)

    def refresh_tor(self):
        tor = is_active("tor@default.service") or is_active("tor.service")
        pct, summ = tor_bootstrap()
        if pct >= 0:
            self.tor_bar.set_fraction(pct / 100.0)
            self.tor_bar.set_text(f"{pct}% — {summ}")
        else:
            self.tor_bar.set_fraction(1.0 if tor else 0.0)
            self.tor_bar.set_text("connected" if tor else "not connected")
        self.tor_state.set_markup("Tor is " + (colored("running", TEAL) if tor else colored("stopped", RED)))

    def refresh_i2p(self):
        i2p = is_active("i2pd.service")
        self.i2p_state.set_markup("i2pd is " + (colored("running", TEAL) if i2p else colored("stopped", RED)))

    def refresh_vpn(self):
        names = []
        try:
            names = sorted(n.rsplit(".", 1)[0] for n in os.listdir(VPN_DIR)
                           if n.endswith((".conf", ".ovpn")))
        except OSError:
            pass
        self._fill_list(self.vpn_list, names)

    def refresh_split(self):
        domains = run([helper("aegis-route-domain"), "list"]).stdout.split()
        self._fill_list(self.site_list, [d for d in domains if d])
        ips = []
        out = run(["sh", "-c", "nft list set inet aegis bypass4 2>/dev/null; nft list set inet aegis bypass6 2>/dev/null"]).stdout
        for part in out.replace("\n", " ").split("elements = {", 1)[-1:]:
            ips += [x.strip().strip("}").strip() for x in part.split(",") if x.strip().strip("}").strip()]
        self._fill_list(self.ip_list, [i for i in ips if any(c.isdigit() for c in i)])

    def refresh_all(self):
        self.refresh_status_fields()
        self.refresh_tor()
        self.refresh_i2p()
        self.refresh_vpn()
        self.refresh_split()

    def _tick(self):
        # keep the live bits fresh without hammering
        self.refresh_status_fields()
        if self.stack.get_visible_child_name() == "tor":
            self.refresh_tor()
        return True


def main():
    win = AegisControl()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
