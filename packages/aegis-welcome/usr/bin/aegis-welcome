#!/usr/bin/python3
# Aegis Welcome — a friendly first-boot wizard. Greets the user, lets them pick a
# network mode and MAC behaviour in plain language, and offers to install Aegis to
# disk. Runs once (autostarted on first login); after it finishes it drops a marker
# so it never nags again.
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib
import os
import subprocess
import sys

MARKER = os.path.expanduser("~/.config/aegis/welcome-done")

MODES = [
    ("tor",    "Tor — recommended",
     "Everything goes through Tor. Fail-closed: if it can't go over Tor, it's blocked."),
    ("both",   "Tor + I2P",
     "Tor for normal traffic, plus the I2P network for .i2p sites."),
    ("i2p",    "I2P only",
     "Use the I2P overlay network. For .i2p eepsites and I2P-aware apps."),
    ("direct", "Direct (not anonymous)",
     "No anonymity routing. Only for setup/debugging on a trusted network."),
]


def already_done():
    return os.path.exists(MARKER)


def write_marker():
    try:
        os.makedirs(os.path.dirname(MARKER), exist_ok=True)
        with open(MARKER, "w") as f:
            f.write("done\n")
    except OSError:
        pass


class Welcome(Gtk.Assistant):
    def __init__(self):
        super().__init__()
        self.set_title("Welcome to Aegis OS")
        self.set_default_size(620, 460)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.mode = "tor"
        self.spoof_mac = True
        self.do_install = False

        self._page_intro()
        self._page_netmode()
        self._page_mac()
        self._page_finish()

        self.connect("apply", self.on_apply)
        self.connect("cancel", lambda *_: self.quit())
        self.connect("close", lambda *_: self.finish())

    # ---- pages ----------------------------------------------------------
    def _page_intro(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_border_width(24)
        title = Gtk.Label()
        title.set_markup("<span size='xx-large' weight='bold'>Welcome to Aegis OS</span>")
        title.set_xalign(0)
        body = Gtk.Label(xalign=0)
        body.set_line_wrap(True)
        body.set_markup(
            "Aegis is a privacy-first, <b>amnesic</b> operating system: it routes your "
            "traffic through Tor (or I2P), randomises your identity each boot, and — on "
            "the live USB — forgets everything when you shut down or pull the stick.\n\n"
            "This quick setup takes about 30 seconds. You can change anything later in the "
            "<b>Aegis Control Center</b>.")
        box.pack_start(title, False, False, 0)
        box.pack_start(body, False, False, 0)
        self.append_page(box)
        self.set_page_type(box, Gtk.AssistantPageType.INTRO)
        self.set_page_title(box, "Welcome")
        self.set_page_complete(box, True)

    def _page_netmode(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(24)
        head = Gtk.Label(xalign=0)
        head.set_markup("<b>How should Aegis reach the network?</b>")
        box.pack_start(head, False, False, 6)
        group = None
        self.mode_radios = {}
        for key, name, desc in MODES:
            rb = Gtk.RadioButton.new_with_label_from_widget(group, name)
            if group is None:
                group = rb
            if key == "tor":
                rb.set_active(True)
            d = Gtk.Label(xalign=0)
            d.set_markup(f"<small>{GLib.markup_escape_text(desc)}</small>")
            d.set_margin_start(26)
            box.pack_start(rb, False, False, 0)
            box.pack_start(d, False, False, 0)
            self.mode_radios[key] = rb
        self.append_page(box)
        self.set_page_type(box, Gtk.AssistantPageType.CONTENT)
        self.set_page_title(box, "Network")
        self.set_page_complete(box, True)

    def _page_mac(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(24)
        head = Gtk.Label(xalign=0)
        head.set_markup("<b>Hardware privacy</b>")
        box.pack_start(head, False, False, 6)
        self.chk_mac = Gtk.CheckButton(label="Randomise (spoof) my MAC address")
        self.chk_mac.set_active(True)
        info = Gtk.Label(xalign=0)
        info.set_line_wrap(True)
        info.set_markup("<small>Stops the networks you join from recognising this machine "
                        "by its network card. Recommended on public Wi-Fi.</small>")
        info.set_margin_start(26)
        box.pack_start(self.chk_mac, False, False, 0)
        box.pack_start(info, False, False, 0)
        self.append_page(box)
        self.set_page_type(box, Gtk.AssistantPageType.CONTENT)
        self.set_page_title(box, "Hardware")
        self.set_page_complete(box, True)

    def _page_finish(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_border_width(24)
        head = Gtk.Label(xalign=0)
        head.set_markup("<b>All set.</b>")
        box.pack_start(head, False, False, 0)
        body = Gtk.Label(xalign=0)
        body.set_line_wrap(True)
        body.set_markup("Your choices will be applied now. You're running the live session — "
                        "nothing is written to disk unless you install.\n\n"
                        "Want to keep Aegis on this computer?")
        box.pack_start(body, False, False, 0)
        self.chk_install = Gtk.CheckButton(label="Install Aegis to disk when I finish")
        box.pack_start(self.chk_install, False, False, 0)
        self.append_page(box)
        self.set_page_type(box, Gtk.AssistantPageType.CONFIRM)
        self.set_page_title(box, "Finish")
        self.set_page_complete(box, True)

    # ---- actions --------------------------------------------------------
    def on_apply(self, *_):
        self.mode = next((k for k, rb in self.mode_radios.items() if rb.get_active()), "tor")
        self.spoof_mac = self.chk_mac.get_active()
        self.do_install = self.chk_install.get_active()
        # Apply the network mode (persist + firewall) via the privileged helper.
        subprocess.run(["pkexec", "/usr/sbin/aegis-netmode-set", self.mode], check=False)
        if self.spoof_mac:
            subprocess.run(["pkexec", "/usr/sbin/aegis-mac-spoof"], check=False)

    def finish(self):
        write_marker()
        if self.do_install:
            for launcher in (["aegis-installer"], ["pkexec", "calamares"], ["calamares"]):
                if subprocess.run(["which", launcher[0]], capture_output=True).returncode == 0:
                    subprocess.Popen(launcher)
                    break
        self.quit()

    def quit(self):
        write_marker()
        Gtk.main_quit()


def main():
    if already_done():
        return 0
    win = Welcome()
    win.connect("destroy", lambda *_: Gtk.main_quit())
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
