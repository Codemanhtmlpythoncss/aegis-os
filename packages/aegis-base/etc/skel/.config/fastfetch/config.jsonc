// Aegis OS fastfetch config. Run with: fastfetch --config /etc/fastfetch/aegis.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/etc/aegis/aegis-logo.txt",
    "color": { "1": "38;2;45;212;191", "2": "38;2;233;238;245" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": { "separator": "  " },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "38;2;45;212;191", "host": "38;2;45;212;191" } },
    "separator",
    { "type": "os",       "key": "  OS      ", "keyColor": "38;2;45;212;191" },
    { "type": "kernel",   "key": "  Kernel  ", "keyColor": "38;2;45;212;191" },
    { "type": "host",     "key": "  Host    ", "keyColor": "38;2;45;212;191" },
    { "type": "uptime",   "key": "  Uptime  ", "keyColor": "38;2;45;212;191" },
    { "type": "packages", "key": "  Packages", "keyColor": "38;2;45;212;191" },
    { "type": "shell",    "key": "  Shell   ", "keyColor": "38;2;45;212;191" },
    { "type": "de",       "key": "  Desktop ", "keyColor": "38;2;45;212;191" },
    { "type": "memory",   "key": "  Memory  ", "keyColor": "38;2;45;212;191" },
    "break",
    { "type": "custom", "format": "  \u001b[38;2;45;212;191m●\u001b[0m amnesic · Tor / I2P · identity randomised each boot" },
    "break"
  ]
}
