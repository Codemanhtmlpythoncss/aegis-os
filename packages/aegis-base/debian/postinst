#!/bin/sh
# aegis-base postinst
set -e

case "$1" in
    configure)
        # Apply sysctl now (best-effort; some keys are absent in containers/VMs).
        sysctl --system >/dev/null 2>&1 || true
        # Brand the OS as Aegis (keeps ID=debian so apt/compat stays intact).
        [ -x /usr/lib/aegis/aegis-branding ] && /usr/lib/aegis/aegis-branding || true
        # Mandatory access control on.
        systemctl enable apparmor >/dev/null 2>&1 || true
        # Show the Aegis fastfetch banner in interactive terminals (once per shell).
        BRC=/etc/bash.bashrc
        if [ -f "$BRC" ] && ! grep -q 'aegis-fastfetch' "$BRC"; then
            cat >> "$BRC" <<'FF'

# >>> aegis-fastfetch >>>
if [ -z "${AEGIS_FF:-}" ] && [ -t 1 ] && [ -z "${AEGIS_NO_FASTFETCH:-}" ] && command -v fastfetch >/dev/null 2>&1; then
    export AEGIS_FF=1
    fastfetch --config /etc/fastfetch/aegis.jsonc 2>/dev/null || fastfetch 2>/dev/null || true
fi
# <<< aegis-fastfetch <<<
FF
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

#DEBHELPER#
exit 0
