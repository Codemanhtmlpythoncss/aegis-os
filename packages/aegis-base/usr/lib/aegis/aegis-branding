#!/bin/sh
# aegis-branding — present the system as "Aegis OS" without changing ID=debian
# (so apt sources, compatibility checks and third-party repos keep working).
# Idempotent; safe to run on every package configure.
set -e

if [ -f /etc/os-release ]; then
    sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Aegis OS 1.2"/' /etc/os-release || true
    sed -i 's/^NAME=.*/NAME="Aegis OS"/' /etc/os-release || true
    sed -i 's#^HOME_URL=.*#HOME_URL="https://github.com/Codemanhtmlpythoncss/aegis-os"#' /etc/os-release || true
    sed -i 's#^SUPPORT_URL=.*#SUPPORT_URL="https://github.com/Codemanhtmlpythoncss/aegis-os"#' /etc/os-release || true
    sed -i 's#^BUG_REPORT_URL=.*#BUG_REPORT_URL="https://github.com/Codemanhtmlpythoncss/aegis-os/issues"#' /etc/os-release || true
    sed -i 's/^VERSION=.*/VERSION="1.2 (Aegis)"/' /etc/os-release || true
    # Show the Aegis version, not Debian's, in VERSION_ID (fastfetch/tools read it).
    if grep -q '^VERSION_ID=' /etc/os-release; then
        sed -i 's/^VERSION_ID=.*/VERSION_ID="1.2"/' /etc/os-release || true
    else
        echo 'VERSION_ID="1.2"' >> /etc/os-release
    fi
    grep -q '^PRETTY_NAME=' /etc/os-release || echo 'PRETTY_NAME="Aegis OS 1.2"' >> /etc/os-release
fi

printf 'Aegis OS \\n \\l\n\n' > /etc/issue
printf 'Aegis OS\n' > /etc/issue.net
printf '\nAegis OS — privacy-focused, amnesic, Tor/I2P. Stay sharp.\n\n' > /etc/motd

if [ -f /etc/lsb-release ]; then
    sed -i 's/^DISTRIB_ID=.*/DISTRIB_ID=Aegis/' /etc/lsb-release || true
    sed -i 's/^DISTRIB_DESCRIPTION=.*/DISTRIB_DESCRIPTION="Aegis OS"/' /etc/lsb-release || true
else
    printf 'DISTRIB_ID=Aegis\nDISTRIB_DESCRIPTION="Aegis OS"\n' > /etc/lsb-release
fi

if [ -f /etc/default/grub ]; then
    if grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub; then
        sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Aegis"/' /etc/default/grub
    else
        echo 'GRUB_DISTRIBUTOR="Aegis"' >> /etc/default/grub
    fi
fi
exit 0
