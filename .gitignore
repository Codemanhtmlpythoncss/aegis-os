# --- build outputs ---
*.iso
*.iso.sha256
*.log
*.img

# --- live-build working/generated dirs ---
.build/
chroot/
chroot.packages.*
binary/
binary.modified/
tftpboot/
cache/
auto/
# Anchor to the repo root: this is live-build's generated top-level local/ dir.
# WITHOUT the leading slash this also matched config/includes.chroot/usr/local/,
# silently excluding every hand-written aegis-* helper from git (and thus from
# the CI-built ISO) — which left aegis-hostname/aegis-firewall/aegis-apply/etc.
# "not found" at runtime. Keep it anchored.
/local/

# --- live-build's own generated config files (we ship only package-lists/hooks/includes) ---
config/binary
config/bootstrap
config/chroot
config/common
config/source
config/hooks/live/
config/includes.binary/
config/package-lists/live
config/package-lists/firmware*

# --- staged by build.sh from the canonical sources (regenerated each build) ---
config/includes.chroot/etc/aegis/build.env
config/includes.chroot/etc/calamares/
config/includes.chroot/usr/share/aegis/
config/package-lists/de-xfce.list.chroot
config/package-lists/browser-firefox.list.chroot

# --- Debian package build artifacts (built in CI, never committed) ---
packages/*.deb
packages/*.changes
packages/*.buildinfo
packages/out/
packages/**/debian/.debhelper/
packages/**/debian/debhelper-build-stamp
packages/**/debian/files
packages/**/debian/*.substvars
packages/**/debian/*.debhelper.log
packages/**/debian/aegis-base/
packages/**/debian/aegis-firewall/
packages/**/debian/aegis-meta/

# --- python / editor cruft ---
__pycache__/
*.pyc
.DS_Store

# staged by build.sh from live-build defaults (regenerated each build)
config/bootloaders/
